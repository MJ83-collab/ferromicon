<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Promemoria prima del servizio e riprogrammazione dopo il riavvio -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".FerromiconApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Tema">

        <activity
            android:name=".BenvenutoActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ServizioActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CercaCidActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".LicenzeActivity"
            android:exported="false"
            android:parentActivityName=".ImpostazioniActivity" />

        <activity
            android:name=".AnnoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".StazioniActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RecuperoFestiviActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CedoliniActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <receiver
            android:name=".InstallazioneReceiver"
            android:exported="false" />

        <activity
            android:name=".DiarioActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CartellinoSapActivity"
            android:exported="false"
            android:label="Cartellino SAP"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".EsportaActivity"
            android:exported="false"
            android:label="Report e dati"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".WikiActivity"
            android:exported="false"
            android:label="Wiki Ferrovia"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".StraordinarioActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ConfrontoActivity"
            android:exported="false"
            android:parentActivityName=".StraordinarioActivity" />

        <activity
            android:name=".VademecumActivity"
            android:exported="false"
            android:parentActivityName=".ConfrontoActivity" />

        <activity
            android:name=".TurnoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CalendarioTelefonoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AgenteActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".FerieActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PerimetriActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AbilitazioniActivity"
            android:exported="false"
            android:label="Abilitazioni"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".CronologiaTrenoActivity"
            android:exported="false"
            android:label="Cerca treno"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ImpostazioniActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <receiver
            android:name=".PromemoriaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <receiver
            android:name=".WidgetProssimo"
            android:exported="false"
            android:label="Prossimo servizio">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prossimo_info" />
        </receiver>

        <receiver
            android:name=".WidgetOggi"
            android:exported="false"
            android:label="Oggi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_oggi_info" />
        </receiver>

        <receiver
            android:name=".WidgetRiposo"
            android:exported="false"
            android:label="Prossimo riposo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_riposo_info" />
        </receiver>

        <receiver
            android:name=".WidgetPermessi"
            android:exported="false"
            android:label="Permessi da usare">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_permessi_info" />
        </receiver>

        <receiver
            android:name=".WidgetMese"
            android:exported="false"
            android:label="Il mio mese">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mese_info" />
        </receiver>
            <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.aggiornamenti"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

</application>

</manifest>
