<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/w_etichetta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/testo_secondario"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_titolo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/testo"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_dettaglio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/testo"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/testo_secondario"
        android:textSize="12sp" />
</LinearLayout>
